# Install as /etc/autorse/selfhost.env, root:root mode 0600.
# Values here are paths and public metadata, never secret key contents.
AUTORSE_PUBLIC_ORIGIN=https://114.66.48.196
AUTORSE_STATE_DIR=/var/lib/autorse/state
AUTORSE_PRIVATE_DIR=/var/lib/autorse/private
AUTORSE_RUNTIME_DIR=/opt/autorse/current/runtime
AUTORSE_SIGNING_KEY_FILE=/var/lib/autorse/secrets/receipt.key
AUTORSE_SESSION_SECRET_FILE=/var/lib/autorse/secrets/session.key
AUTORSE_PRIVATE_MANIFEST_SHA256=3cb6659ce44a0567a78a1465475df0df8a28cc1cb9451de060fa246a5d4f63a2
